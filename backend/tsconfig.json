{
  "compilerOptions": {
    // Module & Target pour Node ESM
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "node",

    // Types Node et autres bibliothèques
    "types": ["node"],

    // Déclarations et sourcemaps
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Stricte vérification TypeScript
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,

    // Compatibilité ESModule
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",

    // Vérifications et style
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}